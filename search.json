---
layout: null
---
[
  {% for page in site.pages %}
    {% if page.url != "/search.json" and page.url != "/" and page.url != "/readme.html" %}
    {
      "title": "{{ page.title | default: page.url | replace: '/', '' | replace: '.html', '' | replace: '-', ' ' | capitalize }}",
      "url": "{{ page.url }}",
      "content": {{ page.content | strip_html | strip_newlines | replace: '"', '\\"' | truncatewords: 200 | jsonify }},
      "excerpt": "{{ page.content | strip_html | strip_newlines | truncatewords: 50 | replace: '"', '\\"' }}",
      "categories": "nabi prophet islam"
    }{% unless forloop.last %},{% endunless %}
    {% endif %}
  {% endfor %}
]
